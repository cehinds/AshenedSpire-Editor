{
  "name": "ashenedspire-editor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node tests/core.test.mjs && node tests/sites-worker.test.mjs && node tests/authoring-create.test.mjs && node tests/native-document.test.mjs && node tests/game-settings.test.mjs && node tests/xlsx.test.mjs && node --test tests/workspace-host.test.mjs tests/pages.test.mjs tests/auth-host.test.mjs tests/native-bridge-host.test.mjs tests/local-branches.test.mjs",
    "test:xlsx": "node tests/xlsx.test.mjs",
    "test:auth": "node --test tests/auth-host.test.mjs",
    "test:pages": "node --test tests/pages.test.mjs",
    "review:quick": "node scripts/review-quick.mjs",
    "check:branches": "node scripts/check-branch-policy.mjs",
    "test:host": "node --test tests/workspace-host.test.mjs tests/local-branches.test.mjs tests/native-bridge-host.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
